# SLM Weekly Informes — web page + team database.
# Generated by deploy/install-service.sh from deploy/systemd/slm-informes.service.in (edit the template, then re-run the installer).
[Unit]
Description=SLM Weekly Informes (web page + team database)
Documentation=file://@INSTALL_DIR@/README.md
After=network-online.target
Wants=network-online.target
# If it keeps crashing, stop retrying after 10 attempts in 5 minutes (see: journalctl -u @SERVICE_NAME@).
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_USER@
WorkingDirectory=@INSTALL_DIR@
# Settings: PORT, HOST, SLM_DB, SLM_BASIC_AUTH, SLM_MAX_UPLOAD_MB
EnvironmentFile=/etc/@SERVICE_NAME@/@SERVICE_NAME@.env
ExecStart=@NODE_BIN@ @INSTALL_DIR@/server/server.js
# Start again automatically after a crash, a kill, a library update (needrestart) and at every boot.
Restart=always
RestartSec=5
# The server closes the database cleanly on SIGTERM.
KillSignal=SIGTERM
TimeoutStopSec=20
UMask=0027
LimitNOFILE=8192

# Hardening: the program can only write to the data folder.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=@DATA_DIR@
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
@CAPABILITIES@

[Install]
WantedBy=multi-user.target
